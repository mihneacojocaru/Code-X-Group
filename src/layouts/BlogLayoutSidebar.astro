---
import type { SanityPost } from "@/types/sanity";
import { PortableText } from "astro-portabletext";

// main layout
import BaseLayout from "./BaseLayout.astro";

// components
import Button from "@/components/button/Button.astro";
import CategoryBadge from "@/components/category/CategoryBadge.astro";
import ShareButtons from "@/components/share-buttons/ShareButtons.astro";
import TableOfContents from "@/components/table-of-contents/TableOfContents.astro";

// utils
import { formatDate } from "@/js/textUtils";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getLocalizedRoute, useTranslations } from "@/js/translationUtils";
import { urlFor } from "@/lib/sanity";
import { extractHeadingsFromBody } from "@/js/blogUtils";

interface Props {
  post: SanityPost;
}

const { post } = Astro.props;
const { title, description, author, publishedAt, updatedAt, categories, heroImage, body } = post;

const currLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currLocale);

const pubDate = new Date(publishedAt);
const updDate = updatedAt ? new Date(updatedAt) : undefined;

const heroImageUrl = heroImage ? urlFor(heroImage).width(1200).auto("format").url() : null;
const authorAvatarUrl = author?.avatar ? urlFor(author.avatar).width(100).auto("format").url() : null;

const headings = extractHeadingsFromBody(body);
---

<BaseLayout type="blog" title={title} description={description} post={post}>
  <article class="site-container" aria-labelledby="article-title">
    <!-- Hero Section with Featured Image -->
    <div class="relative mx-auto max-w-6xl pt-10">
      <!-- Featured Image (if provided) -->
      {
        heroImageUrl && (
          <div class="mb-10 overflow-hidden rounded-3xl">
            <img
              src={heroImageUrl}
              alt={heroImage?.alt ?? `article: ${title}`}
              loading="eager"
              class="h-auto w-full object-cover"
              width={1200}
            />
          </div>
        )
      }

      <!-- Categories -->
      <div class="mb-6 flex flex-wrap gap-3">
        {categories && categories.map((category) => <CategoryBadge category={category} />)}
      </div>

      <!-- Title and Description -->
      <h1 id="article-title" class="h2 mb-4 text-pretty">
        {title}
      </h1>

      <p class="text-muted-foreground mb-8 max-w-3xl md:text-lg">
        {description}
      </p>

      <!-- Article Meta -->
      <div class="mb-10 flex items-center justify-between border-b pb-6">
        <div class="flex items-center gap-4">
          {
            author && (
              <a
                href={author.authorLink ?? "#"}
                class="group flex items-center gap-3"
                aria-label={`Author: ${author.name}`}
              >
                {authorAvatarUrl ? (
                  <div class="size-12 overflow-hidden rounded-full border">
                    <img
                      src={authorAvatarUrl}
                      alt={author.name}
                      width={100}
                      class="h-full w-full object-cover"
                    />
                  </div>
                ) : (
                  <div class="size-12 overflow-hidden rounded-full border bg-muted flex items-center justify-center">
                    <span class="text-lg font-medium">{author.name.charAt(0)}</span>
                  </div>
                )}
                <div>
                  <span class="group-hover:text-primary-accent block font-medium transition-colors">
                    {author.name}
                  </span>
                  <div class="text-muted-foreground flex items-center gap-2 text-sm">
                    <time datetime={pubDate.toISOString()}>{formatDate(pubDate, currLocale)}</time>
                    {updDate && (
                      <>
                        <span>•</span>
                        <span>
                          {t("updated")}: {formatDate(updDate, currLocale)}
                        </span>
                      </>
                    )}
                  </div>
                </div>
              </a>
            )
          }
          {
            !author && (
              <div class="text-muted-foreground text-sm">
                <time datetime={pubDate.toISOString()}>{formatDate(pubDate, currLocale)}</time>
              </div>
            )
          }
        </div>
      </div>
    </div>

    <!-- Content Section with Sidebar -->
    <div
      class="mx-auto grid max-w-6xl gap-8 pb-16 md:grid-cols-1 lg:grid-cols-[330px_1fr] lg:gap-12"
    >
      <!-- Sidebar with Table of Contents -->
      <aside class="">
        <div class="sticky top-24">
          <h2 class="mb-6 text-lg font-medium">{t("table_of_contents")}</h2>
          {headings.length > 0 && <TableOfContents headings={headings} />}
        </div>
      </aside>

      <!-- Main Content -->
      <div class="">
        <div class="markdown-content">
          {body && <PortableText value={body} />}
        </div>

        <!-- After Content Section -->
        <div class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t pt-8">

          <!-- Share Links -->
          <div class="flex items-center gap-3">
            <span class="text-muted-foreground text-sm">{t("share_this_article")}:</span>
            <ShareButtons title={title} url={Astro.url} />
          </div>

          <Button href={getLocalizedRoute(currLocale, "/blog")} variant="secondary" arrow="left">
            {t("back_to_all_posts")}
          </Button>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // Add id attributes to headings inside .markdown-content so the TOC links work.
  // Mirrors the server-side slugify logic.
  function slugify(text: string): string {
    return text
      .toString()
      .toLowerCase()
      .replace(/\s+/g, "-")
      .replace(/[^\w-]+/g, "")
      .replace(/--+/g, "-")
      .replace(/^-+/, "")
      .replace(/-+$/, "");
  }

  function addHeadingIds() {
    const headings = document.querySelectorAll(
      ".markdown-content h2, .markdown-content h3, .markdown-content h4, .markdown-content h5, .markdown-content h6",
    );
    headings.forEach((heading) => {
      if (!heading.id) {
        heading.id = slugify(heading.textContent ?? "");
      }
    });
  }

  addHeadingIds();
  document.addEventListener("astro:after-swap", addHeadingIds);
</script>
