---
interface TableRow {
  _key: string;
  cells?: string[];
}

interface Props {
  node: {
    rows?: TableRow[];
  };
}

const { node } = Astro.props;
const rows = node.rows ?? [];
const [headerRow, ...bodyRows] = rows;
---

{
  rows.length > 0 && (
    <div class="my-6 overflow-x-auto rounded-lg border border-border">
      <table class="w-full text-sm">
        {headerRow?.cells && headerRow.cells.length > 0 && (
          <thead class="bg-muted">
            <tr>
              {headerRow.cells.map((cell) => (
                <th class="border-border border-b px-4 py-3 text-left font-semibold">
                  {cell}
                </th>
              ))}
            </tr>
          </thead>
        )}
        {bodyRows.length > 0 && (
          <tbody>
            {bodyRows.map((row, rowIndex) => (
              <tr class={rowIndex % 2 === 1 ? "bg-muted/40" : ""}>
                {row.cells?.map((cell) => (
                  <td class="border-border border-b px-4 py-3 last:border-b-0">
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        )}
      </table>
    </div>
  )
}
