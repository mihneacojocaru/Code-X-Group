---
import Button from "@/components/button/Button.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { useTranslations, getLocalizedRoute } from "@/js/translationUtils";

const currLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currLocale);
---

<section class="overflow-hidden content-margin">
  <div class="site-container">
    <div class="bg-gradient-radial-dark rounded-6xl py-24" data-mos="fade-up" data-mos-delay="0.5">
      <div class="mx-auto px-4 text-center md:max-w-2xl">
        <span class="badge text">Code-X Consulting</span>
        <h2 class="h3 mb-6">{t("cta_heading")}</h2>
        <p class="text-muted-foreground mx-auto mb-12 max-w-lg">{t("cta_text")}</p>
        <Button href={getLocalizedRoute(currLocale, "/contact")} class="mx-auto px-14">
          {t("cta_button")}
        </Button>
      </div>
    </div>
  </div>
</section>
