---
import Button from "@/components/button/Button.astro";
---

<section class="overflow-hidden py-24">
  <div class="site-container">
    <div class="bg-gradient-radial-dark rounded-6xl py-14" data-mos="fade-up" data-mos-delay="0.5">
      <div class="mx-auto px-4 text-center md:max-w-2xl">
        <span class="badge">Code-X Group</span>
        <h2 class="h3 mb-6">Let's talk.</h2>
        <p class="text-muted-foreground mx-auto mb-12 max-w-lg">
          Wenn Sie an Datenräumen, KI oder Plattform-Ökosystemen arbeiten und echten Markterfolg
          erzielen möchten – sprechen wir.
        </p>
        <Button href="/contact" class="mx-auto px-14">Kontakt aufnehmen</Button>
      </div>
    </div>
  </div>
</section>
