---
import { Image } from "astro:assets";
import { getLocalizedRoute } from "@/js/translationUtils";

// utils
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData } from "@/js/translationUtils";

// data
const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);

// images
import logoDark from "@images/CodeX-logo.svg";
import logoLight from "@images/CodeX-logo-light.svg";
---

<a
  class="primary-focus text-foreground flex h-10 items-center gap-2 text-3xl tracking-tight"
  href={getLocalizedRoute(currLocale, "/")}
>
  <!-- Dark mode logo (default, site starts dark) -->
  <Image
    src={logoDark}
    alt={siteData.name}
    loading="eager"
    width={100}
    height={100}
    class="hidden size-18 dark:block"
    aria-hidden="true"
  />
  <!-- Light mode logo -->
  <Image
    src={logoLight}
    alt={siteData.name}
    loading="eager"
    width={100}
    height={100}
    class="block size-18 dark:hidden"
    aria-hidden="true"
  />

  <div class="mt-px">{siteData.name}</div>
</a>
