---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  number?: string;
  linkText?: string;
  linkHref?: string;
}

const { title, description, number, linkText, linkHref } = Astro.props;
---

<div class="tilt-card bg-gradient-radial-dark rounded-5xl border-border/30 relative h-full overflow-hidden border p-12 will-change-transform">
  <div class="relative z-10 flex h-full min-h-[270px] flex-col gap-4">
    {number && <p class="text-primary-accent text-sm font-medium">{number}</p>}
    <h3 class="tracking-4xl text-5xl font-semibold">{title}</h3>
    <p class="text-muted-foreground text-lg">{description}</p>
    {
      linkText && linkHref && (
        <a class="group mt-auto mb-6 inline-flex items-center" href={linkHref}>
          <span class="mr-3.5 font-medium underline">{linkText}</span>
          <Icon
            class="size-3.5 transform transition duration-300 group-hover:rotate-90"
            name="zenith/arrow"
          />
        </a>
      )
    }
  </div>
  <div
    class="to-primary dark:to-blueGray-500 absolute right-0 bottom-0 size-44 bg-gradient-to-br from-transparent via-transparent blur-lg"
  />
</div>
