---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSideImage from "@/components/hero/HeroSideImage.astro";
import CtaCentered from "@/components/cta/CtaCentered.astro";
import TiltCard from "@/components/feature/TiltCard.astro";
import {Icon} from "astro-icon/components";
import {getLocaleFromUrl} from "@/js/localeUtils";
import {getTranslatedData, getLocalizedRoute} from "@/js/translationUtils";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
const hp = getTranslatedData("homepageData", currLocale);
---

<BaseLayout title={siteData.title} description={siteData.description}>
    <HeroSideImage/>

    <!-- Problem Section -->
    <section class="content-margin">
        <div class="site-container">
            <div class="mb-12 max-w-2xl" data-mos="fade-up">
            <span class="text-primary-accent mb-3 inline-block text-sm font-medium tracking-tighter">
              {hp.problemBadge}
            </span>
                <h2 class="h2 mb-4">{hp.problemHeading}</h2>
                <p class="text-muted-foreground text-lg">{hp.problemIntro}</p>
            </div>
            <div class="grid gap-8 md:grid-cols-2">
                {
                    hp.problems.map((item, i) => (
                        <div
                            class="bg-base-100/30 dark:bg-base-900/30 rounded-3xl border border-white/10 p-8"
                            data-mos="fade-up"
                            data-mos-delay={`${i * 0.1}`}
                        >
                            <h3 class="mb-3 text-xl font-semibold">{item.title}</h3>
                            <p class="text-muted-foreground">{item.description}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Solution Section -->
    <section class="content-margin">
        <div class="site-container">
            <div class="mb-12" data-mos="fade-up">
                <span class="text-primary-accent mb-3 inline-block text-sm font-medium tracking-tighter">
                  {hp.solutionBadge}
                </span>
                <h2 class="h2 mb-6 max-w-2xl">{hp.solutionHeading}</h2>
                <p class="text-muted-foreground max-w-3xl text-lg leading-relaxed">{hp.solutionText}</p>
            </div>

            <!-- Arrows -->
            <div class="mb-10 flex rounded-sm" data-mos="fade-up"
                 data-mos-delay="0.2">
                {hp.solutionItems.map((item, i) => (
                    <div class="relative flex h-24 flex-1 -mr-3 last:mr-0 items-center justify-center">
                        <div class="absolute inset-0 bg-primary [clip-path:polygon(100%_50%,90%_100%,0%_100%,10%_50%,0%_0%,90%_0%)]"/>
                        <Icon name={item.icon} class="relative z-10 size-10 md:size-14 text-primary-foreground"/>
                    </div>
                ))}
            </div>

            <!-- Labels below arrows -->
            <div class="flex flex-col md:grid md:grid-cols-3 gap-4" data-mos="fade-up" data-mos-delay="0.35">
                {hp.solutionItems.map((item) => (
                    <div class="flex flex-col items-center">
                        <h3 class="mb-2 text-2xl font-semibold">{item.title}</h3>
                        <p class="text-muted-foreground">{item.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services-cards" class="content-margin">
        <div class="site-container">
            <div class="mb-12 max-w-2xl" data-mos="fade-up" data-mos-anchor="#services-cards">
            <span class="text-primary-accent mb-3 inline-block text-sm font-medium tracking-tighter">
              {hp.servicesBadge}
            </span>
                <h2 class="h2 mb-4">{hp.servicesHeading}</h2>
                <p class="text-muted-foreground text-lg">{hp.servicesIntro}</p>
            </div>
            <div class="-m-4 flex flex-wrap" id="services-cards-trigger">
                {
                    hp.services.map((item, i) => (
                        <div
                            class="w-full p-4 md:w-1/3"
                            data-mos="fade-up"
                            data-mos-anchor="#services-cards-trigger"
                            data-mos-delay={i * 0.15 + 0.3}
                        >
                            <TiltCard
                                number={item.number}
                                title={item.title}
                                description={item.description}
                                linkText={hp.servicesLinkText}
                                linkHref={getLocalizedRoute(currLocale, "/about")}
                            />
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Industries Section -->
    <section class="bg-base-50/50 dark:bg-base-900/30 content-margin py-16 md:py-20">
        <div class="site-container">
            <div class="mb-12 max-w-2xl" data-mos="fade-up">
            <span class="text-primary-accent mb-3 inline-block text-sm font-medium tracking-tighter">
              {hp.industriesBadge}
            </span>
                <h2 class="h2 mb-4">{hp.industriesHeading}</h2>
                <p class="text-muted-foreground text-lg">{hp.industriesIntro}</p>
            </div>
            <div class="grid gap-8 md:grid-cols-2">
                {
                    hp.industries.map((item, i) => (
                        <div
                            class="flex gap-6 rounded-2xl p-4"
                            data-mos="fade-up"
                            data-mos-delay={`${i * 0.1}`}
                        >
                            <div class="bg-primary/20 text-primary-accent mt-1 flex size-16 shrink-0 items-center justify-center rounded-xl">
                                <Icon name={item.icon} class="size-10" />
                            </div>
                            <div>
                                <h3 class="mb-2 text-lg font-semibold">{item.title}</h3>
                                <p class="text-muted-foreground max-w-md">{item.description}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <CtaCentered/>
</BaseLayout>
