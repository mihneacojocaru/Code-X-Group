---
// layout
import BlogLayout from "@/layouts/BlogLayoutCentered.astro";

// utils
import { getAllPostsForLocale } from "@/js/blogUtils";
import { getLocaleFromUrl } from "@/js/localeUtils";

const currLocale = getLocaleFromUrl(Astro.url);
const posts = await getAllPostsForLocale(currLocale);

const post = posts[0];
---

{post && <BlogLayout post={post} />}
