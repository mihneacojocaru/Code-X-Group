---
import { render } from "astro:content";

// layout
import BlogLayout from "@/layouts/BlogLayoutCentered.astro";

// components
import ExternalLink from "@/components/markdown-components/ExternalLink.astro";

// utils
import { getAllPostsForLocale } from "@/js/blogUtils";
import { getLocaleFromUrl } from "@/js/localeUtils";

const currLocale = getLocaleFromUrl(Astro.url);
const posts = await getAllPostsForLocale(currLocale);

const post = posts[0];

const { Content } = await render(post);
---

<BlogLayout post={post}>
  <Content components={{ a: ExternalLink }} />
</BlogLayout>
