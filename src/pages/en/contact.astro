---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Kontakt – Code-X Group"
  description="Nehmen Sie Kontakt mit Code-X Group auf. Strategiegespräch per E-Mail, LinkedIn oder Calendly buchen."
>
  <section class="overflow-hidden py-24 md:py-32">
    <div class="site-container">
      <div class="mx-auto max-w-2xl text-center" data-mos="fade-up">
        <span
          class="text-primary-accent mb-4 inline-block text-sm font-medium tracking-tighter"
        >
          Code-X Group
        </span>
        <h1 class="h1 mb-6">Let's talk.</h1>
        <p class="text-muted-foreground mx-auto mb-16 max-w-lg text-lg">
          Wenn Sie an Datenräumen, KI oder Plattform-Ökosystemen arbeiten und echten Markterfolg
          erzielen möchten – sprechen wir.
        </p>
      </div>

      <div class="mx-auto grid max-w-3xl gap-6 md:grid-cols-3">
        <!-- Email -->
        <a
          href="mailto:ch@code-x.group"
          class="bg-base-100/30 dark:bg-base-900/30 hover:border-primary/40 group flex flex-col items-center gap-4 rounded-3xl border border-white/10 p-8 text-center transition-colors"
          data-mos="fade-up"
          data-mos-delay="0.1"
        >
          <div
            class="bg-primary/10 text-primary flex size-14 items-center justify-center rounded-2xl"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="mb-1 font-semibold">E-Mail</h3>
            <p class="text-muted-foreground text-sm">Direkte Anfrage für strategische Gespräche</p>
            <span class="text-primary mt-3 block text-sm font-medium">ch@code-x.group</span>
          </div>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/christoph-herr-bonn/"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-base-100/30 dark:bg-base-900/30 hover:border-primary/40 group flex flex-col items-center gap-4 rounded-3xl border border-white/10 p-8 text-center transition-colors"
          data-mos="fade-up"
          data-mos-delay="0.2"
        >
          <div
            class="bg-primary/10 text-primary flex size-14 items-center justify-center rounded-2xl"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-7"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="mb-1 font-semibold">LinkedIn</h3>
            <p class="text-muted-foreground text-sm">Vernetzen & Insights folgen</p>
            <span class="text-primary mt-3 block text-sm font-medium">Christoph Herr</span>
          </div>
        </a>

        <!-- Calendly -->
        <a
          href="#"
          class="bg-base-100/30 dark:bg-base-900/30 hover:border-primary/40 group flex flex-col items-center gap-4 rounded-3xl border border-white/10 p-8 text-center transition-colors"
          data-mos="fade-up"
          data-mos-delay="0.3"
        >
          <div
            class="bg-primary/10 text-primary flex size-14 items-center justify-center rounded-2xl"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="mb-1 font-semibold">Calendly</h3>
            <p class="text-muted-foreground text-sm">Strategiegespräch direkt buchen</p>
            <span class="text-primary mt-3 block text-sm font-medium">Termin buchen</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
