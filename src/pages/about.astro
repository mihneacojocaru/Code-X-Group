---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaCentered from "@/components/cta/CtaCentered.astro";
import TiltCard from "@/components/feature/TiltCard.astro";
import CountUpNumber from "@/components/stats/CountUpNumber.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData } from "@/js/translationUtils";
import { Image } from "astro:assets";
import profileImage from "@images/Christoph-Herr-profile-image.jpeg";

import Star from "@images/headers/star.svg";
import Star2 from "@images/headers/star2.svg";
import Star3 from "@images/headers/star3.svg";
import Lines from "@images/headers/lines.svg";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
const ab = getTranslatedData("aboutData", currLocale);
---

<BaseLayout
  title={`${ab.heroBadge} – ${ab.heroHeading}`}
  description={ab.heroText}
>
  <!-- Hero -->
  <section class="-mt-23 relative items-center overflow-hidden pt-23">
    <div class="pt-20 pb-24">
      <div class="site-container relative">
        <div class="relative z-10 text-center">
          <div data-mos="fade-up">
            <span class="text-primary-accent mb-2.5 inline-block text-xl font-medium tracking-tighter">
              {ab.heroBadge}
            </span>
            <h1 class="font-heading xl:text-10xl mx-auto mb-8 max-w-4xl text-7xl tracking-tighter lg:text-8xl">
              {ab.heroHeading}
            </h1>
          </div>
          <p class="mx-auto mb-10 max-w-md text-lg opacity-80" data-mos="fade-up" data-mos-delay=".15">
            {ab.heroText}
          </p>
        </div>
      </div>
    </div>
    <Star class="text-primary absolute top-24 right-10 hidden md:block" />
    <Star2 class="text-primary absolute top-40 -right-4 hidden md:block" />
    <Star3 class="text-primary absolute top-50 right-20 hidden md:block" />
    <Lines class="absolute top-24 right-0" />
  </section>

  <!-- Mission & Vision -->
  <section class="bg-base-50/50 dark:bg-base-900/30 py-16 md:py-20">
    <div class="site-container">
      <div class="grid gap-12 md:grid-cols-2">
        <div data-mos="fade-right">
          <span class="text-primary-accent mb-3 inline-block text-sm font-medium tracking-tighter">
            {ab.missionBadge}
          </span>
          <h2 class="h2 mb-6">{ab.missionHeading}</h2>
          <p class="text-muted-foreground leading-relaxed">{ab.missionText}</p>
        </div>
        <div data-mos="fade-left">
          <span class="text-primary-accent mb-3 inline-block text-sm font-medium tracking-tighter">
            {ab.visionBadge}
          </span>
          <h2 class="h2 mb-6">{ab.visionHeading}</h2>
          <p class="text-muted-foreground leading-relaxed">{ab.visionText}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Partner -->
  <section class="content-margin">
    <div class="site-container">
      <!-- Header: text left, profile image right -->
      <div class="mb-16 grid grid-cols-1 gap-10 md:grid-cols-2 md:items-center md:gap-16 lg:mb-20">
        <div class="order-2 md:order-1" data-mos="fade-right">
          <span class="text-primary-accent mb-3 inline-block text-xl font-medium tracking-tighter">
            {ab.whyPartner.badge}
          </span>
          <h2 class="h2 mb-6">{ab.whyPartner.heading}</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">{ab.whyPartner.subheading}</p>
        </div>
        <div class="order-1 md:order-2" data-mos="fade-left" data-mos-delay="0.1">
          <Image
            src={profileImage}
            alt="Christoph Herr"
            class="mx-auto w-full max-w-md rounded-2xl object-cover object-top shadow-lg md:aspect-3/4"
            width={600}
            height={800}
          />
        </div>
      </div>

      <!-- Stats -->
      <div class="mb-16 grid gap-10 sm:grid-cols-3">
        {
          ab.whyPartner.stats.map((stat, i) => (
            <div class="text-center" data-mos="fade-up" data-mos-delay={i * 0.15}>
              <p class="mb-2">
                <CountUpNumber
                  value={stat.value}
                  suffix={stat.suffix}
                  class="font-heading text-7xl font-bold tracking-tighter"
                />
              </p>
              <h3 class="mb-1 text-xl font-semibold">{stat.label}</h3>
              <p class="text-muted-foreground text-sm">{stat.description}</p>
            </div>
          ))
        }
      </div>

      <!-- Cards -->
      <div class="grid gap-6 md:grid-cols-3">
        {
          ab.whyPartner.cards.map((card, i) => (
            <div
              class="bg-base-100/30 dark:bg-base-900/50 rounded-3xl border border-white/10 p-8"
              data-mos="fade-up"
              data-mos-delay={i * 0.1}
            >
              <h3 class="mb-3 text-xl font-semibold">{card.title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{card.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Expertise / Leistungen -->
  <section class="content-margin">
    <div class="site-container">
      <div class="mb-12 max-w-2xl" data-mos="fade-up">
        <span class="text-primary-accent mb-3 inline-block text-sm font-medium tracking-tighter">
          {ab.expertiseBadge}
        </span>
        <h2 class="h2 mb-4">{ab.expertiseHeading}</h2>
        <p class="text-muted-foreground text-lg">{ab.expertiseSubheading}</p>
      </div>
      <div class="divide-y divide-white/10">
        {
          ab.expertise.map((item, i) => (
            <div
              class="grid grid-cols-1 gap-10 py-8 md:grid-cols-2 md:gap-16 md:py-20 justify-items-center items-center"
              data-mos="fade-up"
              data-mos-delay={i * 0.1}
            >
              <div class:list={["order-1 md:max-w-xl", { "md:order-last": i % 2 !== 0 }]}>
                <Image
                  src={item.image}
                  alt={item.title}
                  class="w-full rounded-2xl object-cover aspect-4/3"
                  width={700}
                  height={525}
                />
              </div>
              <div class="order-2 max-w-xl h-fit">
                <h3 class="mb-6 text-2xl font-semibold md:text-3xl">{item.title}</h3>
                <ul class="space-y-4">
                  {item.items.map((bullet) => (
                    <li class="text-muted-foreground flex items-start gap-3">
                      <span class="text-primary-accent mt-0.5 flex-shrink-0 font-bold">•</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-base-50/50 dark:bg-base-900/30 content-margin py-16 md:py-20">
    <div class="site-container">
      <div class="mb-12 max-w-2xl" data-mos="fade-up">
        <span class="text-primary-accent mb-3 inline-block text-sm font-medium tracking-tighter">
          {ab.servicesBadge}
        </span>
        <h2 class="h2 mb-4">{ab.servicesHeading}</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-6">
        {
          ab.services.map((item, i) => (
            <div
              class:list={[
                "bg-base-100/30 dark:bg-base-900/50 rounded-3xl border border-white/10 p-8",
                i < 3 ? "lg:col-span-2" : i === 3 ? "lg:col-span-2 lg:col-start-2" : "lg:col-span-2"
              ]}
              data-mos="fade-up"
              data-mos-delay={`${i * 0.1}`}
            >
              <h3 class="mb-3 text-xl font-semibold">{item.title}</h3>
              <p class="text-muted-foreground text-sm">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- References -->
  <section class="content-margin">
    <div class="site-container">
      <div class="mb-12 max-w-2xl" data-mos="fade-up">
        <span class="text-primary-accent mb-3 inline-block text-sm font-medium tracking-tighter">
          {ab.referencesBadge}
        </span>
        <h2 class="h2 mb-4">{ab.referencesHeading}</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-6">
        {
          ab.references.map((item, i) => (
            <div
              class:list={[i < 3 ? "md:col-span-2" : "md:col-span-3"]}
              data-mos="fade-up"
              data-mos-delay={i * 0.1}
            >
              <TiltCard title={item.title} description={item.description} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaCentered />
</BaseLayout>
