{
  "extends": "astro/tsconfigs/base",
  "exclude": ["studio", "node_modules", "dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["src/assets/*"],
      "@images/*": ["src/assets/images/*"],
      "@videos/*": ["src/assets/videos/*"],
      "@/*": ["src/*"]
    }
  }
}
